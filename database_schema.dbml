  "pinpointId" INTEGER
  "riderId" INTEGER
  "customerId" INTEGER
  "kind" errand_proof_images_kind_enum [not null]
  "imageData" LONGTEXT [not null]
  "mimeType" VARCHAR(30) [not null]
  "byteSize" INTEGER [not null]
  "clarityScore" DOUBLE
  "clarityVerdict" errand_proof_images_clarityVerdict_enum
  "capturedAt" DATETIME(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  "verified" BOOLEAN [not null, default: true]
  "declaredTotal" DOUBLE
  "supersededAt" DATETIME(3)

  Indexes {
    errandId [name: "errand_proof_images_errandId_idx"]
    riderId [name: "errand_proof_images_riderId_idx"]
  }
}

Table "receipt_extractions" {
  "id" INTEGER [pk, not null, increment]

  "referenceNo" VARCHAR(40)
  "transactionId" VARCHAR(40)
  "confirmedTotal" DOUBLE
  "confirmedAt" DATETIME(3)
  "extractedAt" DATETIME(3) [not null, default: `CURRENT_TIMESTAMP(3)`]

  Indexes {

Enum "users_role_enum" {
  "OWNER"
  "DISPATCHER"
  "RIDER"
}

Enum "merchant_categories_handlingFeeMode_enum" {
  "THRESHOLD"
  "FLAT"
  "PERCENT"
  "NONE"
}

Enum "errands_status_enum" {
  "AVAILABLE"
  "PENDING"
  "ASSIGNED"
  "IN_TRANSIT"
  "DELIVERED"
  "COMPLETED"
  "CANCELLED"
}

Enum "tbl_blocked_ips_banType_enum" {
  "AUTOMATIC"
  "MANUAL"
}

Enum "tbl_blocked_ips_severity_enum" {
  "LOW"
  "MEDIUM"
  "HIGH"
  "CRITICAL"
}

Enum "tbl_blocked_ips_status_enum" {
  "ACTIVE"
  "EXPIRED"
  "REVOKED"
}

Enum "errand_payments_kind_enum" {
  "UPFRONT"
  "TOP_UP"
  "FINAL"
  "REFUND"
}

Enum "errand_proof_images_kind_enum" {
  "RECEIPT"
  "TRANSFER"
  "PROOF_OF_DELIVERY"
  "NO_RECEIPT"
  "PAYMENT_PROOF"
  "RIDER_BALANCE_PROOF"
  "CASH_COLLECTED"
}

Enum "errand_proof_images_clarityVerdict_enum" {
  "SHARP"
  "ACCEPTABLE"
  "TOO_BLURRY"
  "TOO_DARK"
}

Enum "receipt_extractions_engine_enum" {
  "MLKIT"
  "CLOUD_VISION"
}

Enum "receipt_extractions_status_enum" {
  "OK"
  "NEEDS_REVIEW"
  "FAILED"
}

Enum "rider_status_logs_status_enum" {
  "ONLINE"
  "OFFLINE"
}

Table "users" {
  "id" INTEGER [pk, not null, increment]
  "username" VARCHAR(191) [not null]
  "passwordHash" VARCHAR(191) [not null]
  "role" users_role_enum [not null]
  "firstName" VARCHAR(191) [not null]
  "middleName" VARCHAR(191)
  "lastName" VARCHAR(191) [not null]
  "email" VARCHAR(191) [not null]
  "phone" VARCHAR(191) [not null]
  "avatar" VARCHAR(191)
  "status" VARCHAR(191) [not null, default: 'Active']
  "version" INTEGER [not null, default: 1]
  "updatedBy" INTEGER
  "createdAt" DATETIME(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  "updatedAt" DATETIME(3) [not null]
  "emailVerified" BOOLEAN [not null, default: false]
  "emailVerifiedAt" DATETIME(3)
  "profileCompleted" BOOLEAN [not null, default: true]
  "expoPushToken" VARCHAR(191)

  Indexes {
    username [unique, name: "users_username_key"]
    email [unique, name: "users_email_key"]
  }
}

Table "rider_profile_photos" {
  "id" INTEGER [pk, not null, increment]

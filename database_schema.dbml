Table "connectivity_incidents" {
  "id" INTEGER [pk, not null, increment]
  "riderId" INTEGER [not null]
  "errandId" VARCHAR(191)
  "disconnectedAt" DATETIME(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  "reconnectedAt" DATETIME(3)
  "createdAt" DATETIME(3) [not null, default: `CURRENT_TIMESTAMP(3)`]

  Indexes {
    riderId [name: "connectivity_incidents_riderId_idx"]
  }
}

Table "settlement_records" {
  "id" INTEGER [pk, not null, increment]
  "errandId" VARCHAR(191) [not null]
  "riderId" INTEGER [not null]
  "expectedAmount" DOUBLE [not null]
  "collectedAmount" DOUBLE [not null]
  "variance" DOUBLE [not null]
  "status" VARCHAR(191) [not null]
  "shortReason" VARCHAR(300)
  "proofImageId" INTEGER
  "settledAt" DATETIME(3) [not null, default: `CURRENT_TIMESTAMP(3)`]

  Indexes {
    errandId [unique, name: "settlement_records_errandId_key"]
    proofImageId [unique, name: "settlement_records_proofImageId_key"]
    riderId [name: "settlement_records_riderId_idx"]
  }
}

Table "errand_proof_images" {
  "id" INTEGER [pk, not null, increment]

Table "verified_places" {
  "id" VARCHAR(36) [pk, not null]
  "name" VARCHAR(150) [not null]
  "categoryId" INTEGER [not null]
  "address" VARCHAR(255) [not null]
  "barangay" VARCHAR(80)
  "latitude" DOUBLE [not null]
  "longitude" DOUBLE [not null]
  "keywords" TEXT
  "isActive" BOOLEAN [not null, default: true]
  "createdAt" DATETIME(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  "updatedAt" DATETIME(3) [not null]

  Indexes {
    name [name: "verified_places_name_idx"]
    categoryId [name: "verified_places_categoryId_idx"]
    barangay [name: "verified_places_barangay_idx"]
  }
}

Table "errand_track_points" {
  "id" INTEGER [pk, not null, increment]
  "errandId" VARCHAR(191) [not null]
  "riderId" INTEGER [not null]
  "latitude" DOUBLE [not null]
  "longitude" DOUBLE [not null]
  "accuracyMeters" DOUBLE
  "speedMps" DOUBLE
  "headingDeg" DOUBLE
  "recordedAt" DATETIME(3) [not null]
  "receivedAt" DATETIME(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  "isMapMatched" BOOLEAN [not null, default: false]
  "wasOffline" BOOLEAN [not null, default: false]
  "clientPointId" VARCHAR(36) [not null]

  Indexes {
    (errandId, recordedAt) [name: "errand_track_points_errandId_recordedAt_idx"]
    (riderId, recordedAt) [name: "errand_track_points_riderId_recordedAt_idx"]
    (errandId, clientPointId) [unique, name: "errand_track_points_errandId_clientPointId_key"]
  }
}

Table "dwell_observations" {
  "id" INTEGER [pk, not null, increment]
  "errandId" VARCHAR(191) [not null]
  "pinpointId" INTEGER [not null]
  "categoryId" INTEGER
  "placeId" VARCHAR(36)

  "departedAt" DATETIME(3) [not null]
  "stalled" BOOLEAN [not null, default: false]
  "createdAt" DATETIME(3) [not null, default: `CURRENT_TIMESTAMP(3)`]

  Indexes {
    (categoryId, createdAt) [name: "dwell_observations_categoryId_createdAt_idx"]
    (placeId, createdAt) [name: "dwell_observations_placeId_createdAt_idx"]
  }
}

